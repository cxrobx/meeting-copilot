# Meeting Copilot server — environment variables
#
# Copy this file to `server/.env` and fill in the keys you want. All vars
# are optional: without keys, the server falls back to CLI-based calls
# (claude/gemini/codex) that use your logged-in subscriptions but pay a
# per-invocation process-spawn cost (~1s) and can't use prompt caching.
# With keys set, the realtime-critical paths go direct-to-API for
# substantially lower latency.

# OpenAI key — preferred for latency-critical structured inference:
# GPT-5.6 Luna for triage + agenda deltas, GPT-5.6 Terra for recovery
# coaching + periodic agenda reconciliation, and Luna + web_search for
# Fast Research. Without this, direct Anthropic Haiku is tried next,
# then the logged-in Claude CLI.
OPENAI_API_KEY=

# Anthropic key — direct Haiku fallback for the agenda/coach hot paths
# and Sonnet 5 suggestion generation. Without this, the logged-in Claude
# CLI remains available but cannot guarantee the same live latency.
ANTHROPIC_API_KEY=

# Optional role-specific model overrides.
# COPILOT_TRIAGE_MODEL=gpt-5.6-luna
# COPILOT_AGENDA_MODEL=gpt-5.6-luna
# COPILOT_AGENDA_RECONCILE_MODEL=gpt-5.6-terra
# COPILOT_COACH_MODEL=gpt-5.6-terra
# COPILOT_SUGGEST_MODEL=claude-sonnet-5
# COPILOT_REVIEW_MODEL=claude-opus-5

# Optional: force all live inference to direct APIs or subscription CLIs.
# Defaults to auto (direct API when configured, CLI fallback otherwise).
# COPILOT_LIVE_LLM_MODE=auto

# Optional per-session LLM safety caps. These guard total meeting spend while
# allowing the 30-second agenda reconciliation lane to run for long meetings.
# COPILOT_MAX_LLM_REQUESTS_PER_SESSION=500
# COPILOT_MAX_LLM_TOKENS_PER_SESSION=300000
# COPILOT_MAX_LLM_DOLLARS_PER_SESSION=10

# Optional — used only by the Deepgram cloud transcription provider.
# Local Parakeet is the default (whisper is the local fallback); setting this
# plus explicit cloud-audio consent opts in to Deepgram.
# DEEPGRAM_API_KEY=

# Optional — TCP port the server binds to. Default 17890.
# COPILOT_PORT=17890

# Optional — set to `false` to disable the companion shared-transcript
# writer at ~/.meeting-shared/. Default is enabled.
# SHARE_TRANSCRIPT=true
